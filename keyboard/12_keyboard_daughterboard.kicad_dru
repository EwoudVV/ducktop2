(version 1)
# Keep the first inner layer available for ground. Signal vias may cross it.
(rule "In1.Cu ground only"
  (condition "A.Layer == 'In1.Cu' && A.NetName != 'GND'")
  (constraint disallow track))
# Each LED fits inside its matching CHERRY auxiliary component area.
# The separate placement check verifies its offset, pad envelope and height.
(rule "LED320 inside SW320 light cavity"
  (condition "(A.Reference == 'LED320' && B.Reference == 'SW320') || (A.Reference == 'SW320' && B.Reference == 'LED320')")
  (constraint courtyard_clearance (min -0.01mm)))
(rule "LED321 inside SW321 light cavity"
  (condition "(A.Reference == 'LED321' && B.Reference == 'SW321') || (A.Reference == 'SW321' && B.Reference == 'LED321')")
