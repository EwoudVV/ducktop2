# connector exits, via fanouts and tuning; full traces are also checked geometrically.

(rule "/GBE_HOST_TX first transition approach corner"
    (layer "F.Cu")
    (condition "(A.NetName == '/GBE_HOST_TX_N' || A.NetName == '/GBE_HOST_TX_P') && A.intersectsArea('/GBE_HOST_TX first transition approach corner')")
    (constraint diff_pair_gap (min 0.152400mm) (opt 0.152400mm) (max 0.197000mm)))

(rule "radio connector pad neck"
    (layer "F.Cu")
    (condition "(A.NetName == '/Optional Radio Daughterboard Interface/RADIO_CODEC_USB_DB_DN' || A.NetName == '/Optional Radio Daughterboard Interface/RADIO_CODEC_USB_DB_DP') && A.intersectsArea('radio connector pad neck')")
    (constraint diff_pair_gap (min 0.203200mm) (opt 0.203200mm) (max 0.280000mm)))

(rule "/GBE_HOST_TX actual A1 pad pitch escape"
    (layer "F.Cu")
    (condition "(A.NetName == '/GBE_HOST_TX_N' || A.NetName == '/GBE_HOST_TX_P') && A.intersectsArea('/GBE_HOST_TX actual A1 pad pitch escape')")
    (constraint diff_pair_gap (min 0.152400mm) (opt 0.152400mm) (max 0.321000mm)))

(rule "GBE_HOST_RX A1 pad lands"
    (layer "F.Cu")
    (condition "(A.NetName == '/GBE_HOST_RX_N' || A.NetName == '/GBE_HOST_RX_P') && A.intersectsArea('GBE_HOST_RX A1 pad lands')")
    (constraint diff_pair_gap (min 0.152400mm) (opt 0.152400mm) (max 0.325000mm)))

(rule "GBE_REFCLK A1 pad lands"
    (layer "F.Cu")
    (condition "(A.NetName == '/GBE_REFCLK_N' || A.NetName == '/GBE_REFCLK_P') && A.intersectsArea('GBE_REFCLK A1 pad lands')")
    (constraint diff_pair_gap (min 0.152400mm) (opt 0.152400mm) (max 0.325000mm)))

(rule "/TCP2_TX0 actual A1 pad pitch escape"
    (layer "F.Cu")
    (condition "(A.NetName == '/TCP2_TX0_N' || A.NetName == '/TCP2_TX0_P') && A.intersectsArea('/TCP2_TX0 actual A1 pad pitch escape')")
    (constraint diff_pair_gap (min 0.254000mm) (opt 0.254000mm) (max 0.353000mm)))

(rule "/TCP2_TX1 actual A1 pad pitch escape"
    (layer "F.Cu")
    (condition "(A.NetName == '/TCP2_TX1_N' || A.NetName == '/TCP2_TX1_P') && A.intersectsArea('/TCP2_TX1 actual A1 pad pitch escape')")
    (constraint diff_pair_gap (min 0.254000mm) (opt 0.254000mm) (max 0.353000mm)))

