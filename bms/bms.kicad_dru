(version 1)
(rule "BMS manufacturer pad clearance inside one footprint"
  (condition "A.Type == 'pad' && B.Type == 'pad' && A.Reference == B.Reference")
  (constraint clearance (min 0.15mm)))
(rule "BMS SMD lands on distinct footprints"
  (condition "A.Type == 'pad' && B.Type == 'pad' && A.Pad_Type == 'smd' && B.Pad_Type == 'smd'")
  (constraint clearance (min 0.15mm)))
