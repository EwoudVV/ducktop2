(text "== Native PCIe Gigabit Ethernet on LattePanda Mu default HSIO6 ==" (at 20.32 12.7 0) (effects (font (size 1.27 1.27))) (uuid a8de03ce-3419-505d-a7aa-dcd01c151489))
(text "RTL8111H support circuit follows LattePanda's DFR1142 Mu carrier reference: HSIO6, REFCLK4, CLKREQ4, and PLT_RST." (at 20.32 20.32 0) (effects (font (size 1.27 1.27))) (uuid 2e2090f8-7842-5d9e-abe0-ade328a27c09))
(text "JXD1-1022NL is a true recessed through-hole mid-mount RJ45 with integrated magnetics; no external transformer is required." (at 20.32 27.94 0) (effects (font (size 1.27 1.27))) (uuid 56a24110-0120-5bc8-8221-31253ad042d6))
